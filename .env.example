# Copy to .env and fill in. On the server this file sits next to
# docker-compose.yml (Jenkins uploads it from the "mytrack-env" credential).

# MySQL. From inside Docker, a MySQL running on the server itself is
# reachable as host.docker.internal (see docker-compose.yml).
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=my_track

# Session signing key: any long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Backup → Google Drive (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain/api/auth/google/callback

# Screenshot tracker owner (optional)
SCREENSHOT_OWNER_EMAIL=

# Image downloader: Pexels search (optional)
PEXELS_API_KEY=
