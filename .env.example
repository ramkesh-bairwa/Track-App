# Copy to .env and fill in. On the server it sits in the app folder
# (/var/www/Track-App/.env) and is never sent by deploy/deploy.sh.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=my_track

# Session signing key: any long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Backup (Profile menu -> Backup): uploads a zip to Google Drive containing
# the project's source code plus a database_backup/ folder with a full SQL
# dump of the database. Uploads happen as *you* — clicking "Connect Google
# Drive" in the Backup modal sends you through Google's own sign-in/consent
# screen, so the zip lands in your normal Drive, not a service account's storage.
#
# In Google Cloud Console: APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> type "Web application". Add
# GOOGLE_OAUTH_REDIRECT_URI below as an "Authorized redirect URI" there too —
# it must match exactly (scheme, host, port, path).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Stock photos from Pexels in the photo editor, collage maker, PDF editor and
# the image downloader's "search & download".
# Get a free key at https://www.pexels.com/api/ (takes a minute).
PEXELS_API_KEY=

# Screenshot tracker (scripts/screenshot-tracker/install.sh). This Mac's
# screenshots are filed under the MyTrack account with this email. Only admins
# see them (Screenshots page); make the first admin with `npm run make-admin -- <email>`.
SCREENSHOT_OWNER_EMAIL=
# Folder holding one sub-folder per account. Defaults to public/system-tracker
SCREENSHOT_DIR=

# Image downloader (Dashboard → Image downloader, API at /api/downloader/*).
# Where albums are saved. Defaults to ./downloads (left out of backups).
DOWNLOAD_ROOT=
# Optional: lets tools outside the browser call the API without a login
# (send as x-api-key, Authorization: Bearer, or ?token=).
DOWNLOADER_API_TOKEN=
# Optional tuning: DOWNLOAD_CONCURRENCY=4  MAX_IMAGE_BYTES=52428800  ALLOW_PRIVATE_URLS=false

# Lets the automation tester push testing feedback without a login.
TESTER_API_TOKEN=
