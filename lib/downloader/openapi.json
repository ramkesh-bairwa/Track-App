      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "SSE stream (`text/event-stream`)",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "example": "event: progress\ndata: {\"status\":\"running\",\"completed\":3,\"total\":10,\"progress\":30}\n\nevent: file\ndata: {\"name\":\"cats_1.jpg\",\"bytes\":84321,\"url\":\"/api/downloader/albums/...\"}\n\nevent: done\ndata: {\"status\":\"completed\",\"progress\":100}\n\n"
        }
       }
      }
     },
